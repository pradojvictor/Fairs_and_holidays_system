# Variáveis da API (na Vercel: Settings → Environment Variables; local: copie para .env).
# Nenhuma tem valor padrão para segredo: faltando, a API responde 500 e registra o motivo.

# Gist que guarda os dados (o mesmo que o SAME lê em GITHUB_GIST_ID_FERIAS).
GITHUB_GIST_ID=
# Token com permissão de escrita só em Gists (fine-grained: "Gists: Read and write").
GITHUB_TOKEN=
# Arquivo de dados dentro do Gist. Sessões ficam em sessoes.json, no mesmo Gist.
GITHUB_FILENAME=data.json

# Só para `vercel dev` em http://localhost no Safari: COOKIE_SEGURO=nao tira o Secure do
# cookie. Nunca defina isto na Vercel.
# COOKIE_SEGURO=nao
